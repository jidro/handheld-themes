<theme>
	<formatVersion>7</formatVersion>

	<view name="basic, detailed">

		<helpsystem name="help">
			<fontSize>0.06</fontSize>
			<pos>0.05 0.88</pos>
		</helpsystem>

		<image name="console" extra="true">
			<pos>1 1</pos>
		</image>

		<image name="consolegame" extra="true">
			<pos>1 1</pos>
		</image>

		<image name="logo">
			<pos>0.21 0.12</pos>
			<maxSize>0.32 0.12</maxSize>
			<origin>0.5 0.5</origin>
		</image>

		<image name="console" extra="true">
			<path>./../../art/$system.png</path>
		</image>

	</view>

	<view name="detailed">

		<image name="backtext2" extra="true">
			<pos>0.05 0.21</pos>
